run = "cd NAV-Property-Compiler/src && streamlit run nav_property_compiler/main.py --server.port 8080 --server.address 0.0.0.0"
modules = ["python-3.11"]

[agent]
expertMode = true

[[ports]]
localPort = 8080
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd NAV-Property-Compiler/src && streamlit run nav_property_compiler/main.py --server.port 8080 --server.address 0.0.0.0"]
